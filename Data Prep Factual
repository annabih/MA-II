clear all
set more off

global input "/Users/anna/Desktop/USB/18.05.2026/EUROMOD/InWorkPoverty/EUROMOD_RELEASES_J1.86+/Factual_MA_II/Output"
global output "/Users/anna/Desktop/USB/18.05.2026/EUROMOD/MA_II_Stata_Output/Factual"

local years "2018 2019 2020 2021 2022"

tempfile alldata
local first = 1

foreach yr of local years {

    di _n "=== Importing year `yr' ==="

    import delimited using "$input/`yr'.txt", clear case(preserve)

    gen year = `yr'

    di "Year `yr': " _N " observations"

    if `first' == 1 {
        save `alldata', replace
        local first = 0
    }
    else {
        append using `alldata'
        save `alldata', replace
    }
}

use `alldata', clear

save "$output/EUROMOD_Factual_AllYears_2018_2022.dta", replace

di _n "Complete."
di "Total observations: " _N
tab year
