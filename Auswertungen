*******************************************************************************************************************************************************************************************
*** Titel: Poverty evaluation
*** Aim: Counts and percentages of employed persons below poverty thresholds
*******************************************************************************************************************************************************************************************

clear all
set more off

use "Y:\Desktop\USB\MA_II\EUROMOD_baseline_vs_policy_combined_adjusted.dta", clear

*** N numbers
*******************************************************************************************************************************************************************************************
table year scenario if employed == 1, statistic(sum iw_arop_pre_rel) statistic(sum iw_poor_post_rel) statistic(sum diff_rel) statistic(sum iw_arop_pre_anchor) statistic(sum iw_arop_post_anchor) statistic(sum diff_anchor) statistic(sum threshold_effect_pre) statistic(sum threshold_effect_post) nototals

*** Weighted population numbers
*******************************************************************************************************************************************************************************************
table year scenario if employed == 1 [pw=dwt], statistic(sum iw_arop_pre_rel) statistic(sum iw_poor_post_rel) statistic(sum diff_rel) statistic(sum iw_arop_pre_anchor) statistic(sum iw_arop_post_anchor) statistic(sum diff_anchor) statistic(sum threshold_effect_pre) statistic(sum threshold_effect_post) nototals nformat(%12.0fc sum)

*** % population numbers
*******************************************************************************************************************************************************************************************
table year scenario if employed == 1 [pw=dwt], statistic(mean iw_arop_pre_rel) statistic(mean iw_poor_post_rel) statistic(mean iw_arop_pre_anchor) statistic(mean iw_arop_post_anchor) nototals



*** N numbers (18-64)
*******************************************************************************************************************************************************************************************
table year scenario if employed == 1 & inrange(dag,18,64), statistic(sum iw_arop_pre_rel) statistic(sum iw_poor_post_rel) statistic(sum diff_rel) statistic(sum iw_arop_pre_anchor) statistic(sum iw_arop_post_anchor) statistic(sum diff_anchor) statistic(sum threshold_effect_pre) statistic(sum threshold_effect_post) nototals

*** Weighted population numbers (18-64)
*******************************************************************************************************************************************************************************************
table year scenario if employed == 1 & inrange(dag,18,64) [pw=dwt], statistic(sum iw_arop_pre_rel) statistic(sum iw_poor_post_rel) statistic(sum diff_rel) statistic(sum iw_arop_pre_anchor) statistic(sum iw_arop_post_anchor) statistic(sum diff_anchor) statistic(sum threshold_effect_pre) statistic(sum threshold_effect_post) nototals nformat(%12.0fc sum)

*** % population numbers (18-64)
*******************************************************************************************************************************************************************************************
table year scenario if employed == 1 & inrange(dag,18,64) [pw=dwt], statistic(mean iw_arop_pre_rel) statistic(mean iw_poor_post_rel) statistic(mean iw_arop_pre_anchor) statistic(mean iw_arop_post_anchor) nototals



