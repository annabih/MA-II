********************************************************************************
* EU-SILC Austria 2019 bis 2024: R, P, D und H Dateien zusammenführen
*
* Wichtig:
* R Datei ist der Masterdatensatz, weil sie alle Personen im Haushalt enthält.
*
* Merge Logik:
* R Datei: RB030 = Personal ID, RX030 = Household ID
* P Datei: PB030 = Personal ID, PX030 = Household ID
* D Datei: DB030 = Household ID
* H Datei: HB030 = Household ID
*
* Finale IDs:
* id_person
* id_hh
********************************************************************************

clear all
set more off

********************************************************************************
* 1. Basispfad definieren
********************************************************************************

global base "Y:/Desktop/USB/MA_II/AT_CROSS"


********************************************************************************
* 2. Loop über Jahre 2019 bis 2024
********************************************************************************

foreach yr of numlist 2019/2024 {

    clear

    * zweistellige Jahreskennung für Dateinamen erstellen
    local yy = substr("`yr'", 3, 2)

    * Jahresordner definieren
    local folder "$base/`yr'"

    di "==============================================================================="
    di "Merging EU-SILC Austria `yr'"
    di "Folder: `folder'"
    di "==============================================================================="


    ********************************************************************************
    * 1. R Datei importieren: MASTER, alle Personen
    ********************************************************************************

    import delimited "`folder'/UDB_cAT`yy'R.csv", clear varnames(1) case(preserve)

    rename RX030 id_hh
    rename RB030 id_person

    gen year = `yr'

    di "Observations in R file, should equal final person count:"
    count

    describe id_hh id_person
    duplicates report id_hh id_person

    tempfile rfile
    save `rfile', replace


    ********************************************************************************
    * 2. P Datei importieren: personenbezogene Detailinformationen
    ********************************************************************************

    import delimited "`folder'/UDB_cAT`yy'P.csv", clear varnames(1) case(preserve)

    rename PX030 id_hh
    rename PB030 id_person

    di "Observations in P file:"
    count

    describe id_hh id_person
    duplicates report id_hh id_person

    tempfile pfile
    save `pfile', replace


    ********************************************************************************
    * 3. P an R mergen
    ********************************************************************************

    use `rfile', clear

    merge 1:1 id_hh id_person using `pfile'

    di "Merge R + P:"
    tab _merge

    * Wichtig:
    * _merge == 1: Personen aus R ohne P Informationen, typischerweise Kinder
    * _merge == 3: Personen aus R mit P Informationen
    * _merge == 2: Personen nur in P, sollten normalerweise nicht gebraucht werden
    keep if _merge == 1 | _merge == 3
    drop _merge

    di "Observations after R + P merge, should still equal R count:"
    count

    tempfile rpfile
    save `rpfile', replace


    ********************************************************************************
    * 4. D Datei importieren: Haushaltsregister
    ********************************************************************************

    import delimited "`folder'/UDB_cAT`yy'D.csv", clear varnames(1) case(preserve)

    rename DB030 id_hh

    di "Observations in D file, household level:"
    count

    describe id_hh
    duplicates report id_hh

    tempfile dfile
    save `dfile', replace


    ********************************************************************************
    * 5. D an Personenfile mergen
    ********************************************************************************

    use `rpfile', clear

    merge m:1 id_hh using `dfile'

    di "Merge R/P + D:"
    tab _merge

    * Personen aus R/P behalten
    keep if _merge == 1 | _merge == 3
    drop _merge

    di "Observations after D merge, should still equal R count:"
    count

    tempfile rpdfile
    save `rpdfile', replace


    ********************************************************************************
    * 6. H Datei importieren: Haushaltsinformationen und Haushaltseinkommen
    ********************************************************************************

    import delimited "`folder'/UDB_cAT`yy'H.csv", clear varnames(1) case(preserve)

    rename HB030 id_hh

    di "Observations in H file, household level:"
    count

    describe id_hh
    duplicates report id_hh

    tempfile hfile
    save `hfile', replace


    ********************************************************************************
    * 7. H an Personenfile mergen
    ********************************************************************************

    use `rpdfile', clear

    merge m:1 id_hh using `hfile'

    di "Merge R/P/D + H:"
    tab _merge

    * Personen aus R/P/D behalten
    keep if _merge == 1 | _merge == 3
    drop _merge

    di "Final observations, should still equal R count:"
    count


    ********************************************************************************
    * 8. Finale Datei speichern
    ********************************************************************************

    compress

    save "`folder'/SILC_AT_`yr'_RPDH_merged.dta", replace

    di "Finished year `yr'"
}
