*** Aim: 
*******************************************************************************************************************************************************************************************
clear all
set more off

use "Y:\Desktop\USB\MA_II\EUROMOD_baseline_vs_policy_combined.dta", clear


* Destring, rename, and construct income variable
********************************************************************************

* Convert variables with decimal comma to numeric
destring yds ydses_o ils_dispy ils_ben ils_pen dag dwt, replace dpcomma ignore(" ")

********************************************************************************
* Post- and pre-transfer disposable income, individual level
********************************************************************************

* Rename post-transfer disposable income
rename ils_dispy post_disp_income

* Construct pre-transfer disposable income, pensions included
gen double pre_disp_income = post_disp_income - ils_ben + ils_pen

* Labels
label variable post_disp_income "Post-transfer disposable income"
label variable pre_disp_income  "Pre-transfer disposable income, pensions included"

********************************************************************************
* Construct pre- and post-transfer disposable household income
********************************************************************************

bysort scenario year idhh: egen double post_disp_hh_income = total(post_disp_income)
bysort scenario year idhh: egen double pre_disp_hh_income  = total(pre_disp_income)

label variable post_disp_hh_income "Post-transfer disposable household income"
label variable pre_disp_hh_income  "Pre-transfer disposable household income, pensions included"


********************************************************************************
* OECD equivalence scale
* First person aged 14+ = 1.0
* Additional persons aged 14+ = 0.5
* Children below age 14 = 0.3
********************************************************************************

* Define age groups
gen byte adult14   = dag >= 14 if !missing(dag)
gen byte child_u14 = dag < 14  if !missing(dag)

* Count household members within each scenario-year-household
bysort scenario year idhh: egen n_adult14  = total(adult14)
bysort scenario year idhh: egen n_child_u14 = total(child_u14)

* Modified OECD scale
gen double oecd_scale = 1 + 0.5 * (n_adult14 - 1) + 0.3 * n_child_u14 if n_adult14 >= 1

label variable oecd_scale "OECD equivalence scale"

********************************************************************************
* Equalised household income
********************************************************************************

gen double post_disp_hh_income_equ = post_disp_hh_income / oecd_scale
gen double pre_disp_hh_income_equ  = max(pre_disp_hh_income / oecd_scale, 0)

label variable post_disp_hh_income_equ "Post-transfer disposable household income, equalised"
label variable pre_disp_hh_income_equ  "Pre-transfer disposable household income, equalised, pensions included"



********************************************************************************
* Poverty thresholds:
* 1. Relative threshold by year and scenario
* 2. Anchored threshold: baseline threshold applied to all scenarios
********************************************************************************

gen double poverty_threshold_rel = .
gen double poverty_threshold_anchor = .

levelsof year, local(years)
levelsof scenario, local(scenarios)

********************************************************************************
* 1. Relative / floating threshold: by year and scenario
********************************************************************************

foreach y of local years {
    foreach s of local scenarios {
        quietly _pctile post_disp_hh_income_equ [aw=dwt] if year == `y' & scenario == `s' & dwt > 0 & !missing(post_disp_hh_income_equ, dwt), p(50)
        replace poverty_threshold_rel = r(r1) * 0.6 if year == `y' & scenario == `s'
    }
}

********************************************************************************
* 2. Anchored threshold: baseline threshold applied to all scenarios
********************************************************************************

foreach y of local years {
    quietly _pctile post_disp_hh_income_equ [aw=dwt] if year == `y' & scenario == 0 & dwt > 0 & !missing(post_disp_hh_income_equ, dwt), p(50)
    replace poverty_threshold_anchor = r(r1) * 0.6 if year == `y'
}

label variable poverty_threshold_rel "Relative poverty threshold: 60% median by year and scenario"
label variable poverty_threshold_anchor "Anchored poverty threshold: baseline threshold applied to all scenarios"



********************************************************************************
* Employed variable
********************************************************************************
destring les, replace

gen employed = 0
replace employed = 1 if les == 3

label variable employed "Employed persons"



********************************************************************************
* Poverty indicators: relative / floating threshold
********************************************************************************

gen byte iw_arop_pre_rel = pre_disp_hh_income_equ < poverty_threshold_rel if employed == 1 & !missing(pre_disp_hh_income_equ, poverty_threshold_rel)

gen byte iw_poor_post_rel = post_disp_hh_income_equ < poverty_threshold_rel if employed == 1 & !missing(post_disp_hh_income_equ, poverty_threshold_rel)

label variable iw_arop_pre_rel "Below relative poverty threshold, pre-transfer income"

label variable iw_poor_post_rel "Below relative poverty threshold, post-transfer income"


********************************************************************************
* Poverty indicators: anchored baseline threshold
********************************************************************************

gen byte iw_arop_pre_anchor = pre_disp_hh_income_equ < poverty_threshold_anchor if employed == 1 & !missing(pre_disp_hh_income_equ, poverty_threshold_anchor)

gen byte iw_arop_post_anchor = post_disp_hh_income_equ < poverty_threshold_anchor if employed == 1 & !missing(post_disp_hh_income_equ, poverty_threshold_anchor)

label variable iw_arop_pre_anchor "Below anchored baseline poverty threshold, pre-transfer income"

label variable iw_arop_post_anchor "Below anchored baseline poverty threshold, post-transfer income"


********************************************************************************
* Differences: reduction in poverty from pre- to post-transfer
********************************************************************************

gen byte diff_rel = iw_arop_pre_rel - iw_poor_post_rel if employed == 1
gen byte diff_anchor = iw_arop_pre_anchor - iw_arop_post_anchor if employed == 1

label variable diff_rel "Difference pre - post, relative threshold"
label variable diff_anchor "Difference pre - post, anchored threshold"

********************************************************************************
* Threshold effect: relative threshold vs anchored threshold
********************************************************************************

gen byte threshold_effect_pre = iw_arop_pre_rel - iw_arop_pre_anchor if employed == 1
gen byte threshold_effect_post = iw_poor_post_rel - iw_arop_post_anchor if employed == 1
gen byte threshold_effect_diff = diff_rel - diff_anchor if employed == 1

label variable threshold_effect_pre  "Threshold effect pre"
label variable threshold_effect_post "Threshold effect post"
label variable threshold_effect_diff "Threshold effect diff"

********************************************************************************
* AROP indicators, total population: relative / floating threshold
********************************************************************************

gen byte arop_pre_rel = pre_disp_hh_income_equ < poverty_threshold_rel if !missing(pre_disp_hh_income_equ, poverty_threshold_rel)
gen byte arop_post_rel = post_disp_hh_income_equ < poverty_threshold_rel if !missing(post_disp_hh_income_equ, poverty_threshold_rel)

label variable arop_pre_rel "AROP total pop, pre-transfer, relative threshold"
label variable arop_post_rel "AROP total pop, post-transfer, relative threshold"


********************************************************************************
* AROP indicators, total population: anchored baseline threshold
********************************************************************************

gen byte arop_pre_anchor = pre_disp_hh_income_equ < poverty_threshold_anchor if !missing(pre_disp_hh_income_equ, poverty_threshold_anchor)
gen byte arop_post_anchor = post_disp_hh_income_equ < poverty_threshold_anchor if !missing(post_disp_hh_income_equ, poverty_threshold_anchor)

label variable arop_pre_anchor "AROP total pop, pre-transfer, anchored threshold"
label variable arop_post_anchor "AROP total pop, post-transfer, anchored threshold"


********************************************************************************
* AROP differences and threshold effects, total population
********************************************************************************

gen byte arop_diff_rel = arop_pre_rel - arop_post_rel
gen byte arop_diff_anchor = arop_pre_anchor - arop_post_anchor
gen byte arop_threshold_effect_pre = arop_pre_rel - arop_pre_anchor
gen byte arop_threshold_effect_post = arop_post_rel - arop_post_anchor
gen byte arop_threshold_effect_diff = arop_diff_rel - arop_diff_anchor

label variable arop_diff_rel "AROP diff pre - post, relative threshold"
label variable arop_diff_anchor "AROP diff pre - post, anchored threshold"
label variable arop_threshold_effect_pre "AROP threshold effect pre"
label variable arop_threshold_effect_post "AROP threshold effect post"
label variable arop_threshold_effect_diff "AROP threshold effect diff"


********************************************************************************
* 1. Gap only among poor employed persons
* Positive value = income below threshold
********************************************************************************

gen double gap_pre_rel = poverty_threshold_rel - pre_disp_hh_income_equ if employed == 1 & iw_arop_pre_rel == 1 & !missing(pre_disp_hh_income_equ, poverty_threshold_rel)

gen double gap_post_rel = poverty_threshold_rel - post_disp_hh_income_equ if employed == 1 & iw_poor_post_rel == 1 & !missing(post_disp_hh_income_equ, poverty_threshold_rel)

gen double gap_pre_anchor = poverty_threshold_anchor - pre_disp_hh_income_equ if employed == 1 & iw_arop_pre_anchor == 1 & !missing(pre_disp_hh_income_equ, poverty_threshold_anchor)

gen double gap_post_anchor = poverty_threshold_anchor - post_disp_hh_income_equ if employed == 1 & iw_arop_post_anchor == 1 & !missing(post_disp_hh_income_equ, poverty_threshold_anchor)


********************************************************************************
* 2. Gap over all employed persons
* Non-poor employed persons receive gap = 0
********************************************************************************

gen double gap_pre_rel_all = max(poverty_threshold_rel - pre_disp_hh_income_equ, 0) if employed == 1 & !missing(pre_disp_hh_income_equ, poverty_threshold_rel)

gen double gap_post_rel_all = max(poverty_threshold_rel - post_disp_hh_income_equ, 0) if employed == 1 & !missing(post_disp_hh_income_equ, poverty_threshold_rel)

gen double gap_pre_anchor_all = max(poverty_threshold_anchor - pre_disp_hh_income_equ, 0) if employed == 1 & !missing(pre_disp_hh_income_equ, poverty_threshold_anchor)

gen double gap_post_anchor_all = max(poverty_threshold_anchor - post_disp_hh_income_equ, 0) if employed == 1 & !missing(post_disp_hh_income_equ, poverty_threshold_anchor)


********************************************************************************
* 3. Poverty gap as percentage of threshold
********************************************************************************

gen double gap_pre_rel_pct = 100 * gap_pre_rel / poverty_threshold_rel
gen double gap_post_rel_pct = 100 * gap_post_rel / poverty_threshold_rel

gen double gap_pre_anchor_pct = 100 * gap_pre_anchor / poverty_threshold_anchor
gen double gap_post_anchor_pct = 100 * gap_post_anchor / poverty_threshold_anchor

gen double gap_pre_rel_all_pct = 100 * gap_pre_rel_all / poverty_threshold_rel
gen double gap_post_rel_all_pct = 100 * gap_post_rel_all / poverty_threshold_rel

gen double gap_pre_anchor_all_pct = 100 * gap_pre_anchor_all / poverty_threshold_anchor
gen double gap_post_anchor_all_pct = 100 * gap_post_anchor_all / poverty_threshold_anchor


********************************************************************************
* Labels
********************************************************************************

label variable gap_pre_rel "Mean poverty gap among poor employed, pre-transfer, relative threshold"
label variable gap_post_rel "Mean poverty gap among poor employed, post-transfer, relative threshold"
label variable gap_pre_anchor "Mean poverty gap among poor employed, pre-transfer, anchored threshold"
label variable gap_post_anchor "Mean poverty gap among poor employed, post-transfer, anchored threshold"

label variable gap_pre_rel_all "Mean poverty gap all employed, pre-transfer, relative threshold"
label variable gap_post_rel_all "Mean poverty gap all employed, post-transfer, relative threshold"
label variable gap_pre_anchor_all "Mean poverty gap all employed, pre-transfer, anchored threshold"
label variable gap_post_anchor_all "Mean poverty gap all employed, post-transfer, anchored threshold"

label variable gap_pre_rel_pct "Poverty gap among poor employed in %, pre-transfer, relative threshold"
label variable gap_post_rel_pct "Poverty gap among poor employed in %, post-transfer, relative threshold"
label variable gap_pre_anchor_pct "Poverty gap among poor employed in %, pre-transfer, anchored threshold"
label variable gap_post_anchor_pct "Poverty gap among poor employed in %, post-transfer, anchored threshold"

label variable gap_pre_rel_all_pct "Poverty gap all employed in %, pre-transfer, relative threshold"
label variable gap_post_rel_all_pct "Poverty gap all employed in %, post-transfer, relative threshold"
label variable gap_pre_anchor_all_pct "Poverty gap all employed in %, pre-transfer, anchored threshold"
label variable gap_post_anchor_all_pct "Poverty gap all employed in %, post-transfer, anchored threshold"


save "Y:\Desktop\USB\MA_II\EUROMOD_baseline_vs_policy_combined_adjusted.dta", replace






